            ".btn:hover [data-lucide=\"arrow-up-right\"]",
            ".btn [data-lucide=\"mail\"]",
            ".btn:focus-visible [data-lucide=\"mail\"]",
            ".btn.is-pressed [data-lucide=\"mail\"]",
