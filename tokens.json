{
  "$description": "Portfolio design tokens, DTCG source of truth. Generated artifact is tokens.css (symlinked into the portfolio + case studies). Two-tier: primitives (hue+stop) feed semantics (role). Faithful v1 transcription of the hand-written tokens.css; naming aliases + $type annotations layered in a later stage.",

  "neutral": {
    "0":    { "$value": "#ffffff" },
    "50":   { "$value": "#fafafa" },
    "100":  { "$value": "#f5f5f5" },
    "150":  { "$value": "#f4f4f5" },
    "200":  { "$value": "#ececec" },
    "300":  { "$value": "#e4e4e7" },
    "400":  { "$value": "#d4d4d8" },
    "500":  { "$value": "#a1a1aa" },
    "550":  { "$value": "#909096" },
    "600":  { "$value": "#67676f" },
    "700":  { "$value": "#3f3f46" },
    "800":  { "$value": "#27272a" },
    "850":  { "$value": "#1c1c1f" },
    "900":  { "$value": "#141416" },
    "950":  { "$value": "#0a0a0b" }
  },

  "green": {
    "50":  { "$value": "#faffeb" },
    "100": { "$value": "#f5ffd6" },
    "200": { "$value": "#ecffad" },
    "300": { "$value": "#e2ff85" },
    "400": { "$value": "#daff61" },
    "500": { "$value": "#d2ff37" },
    "550": { "$value": "#b8e030" },
    "600": { "$value": "#c0fa00" },
    "700": { "$value": "#8db800" },
    "800": { "$value": "#5e7a00" },
    "900": { "$value": "#2f3d00" },
    "950": { "$value": "#171f00" }
  },

  "brand": {
    "lime":     { "$value": "{green.500}" },
    "lime-rgb": { "$value": "210 255 55", "$description": "M-27 channel form of --brand-lime for decorative alpha shadows: rgb(var(--brand-lime-rgb) / 0.2)." },
    "lime-dim": { "$value": "{green.550}" },
    "ink":      { "$value": "{neutral.850}" },
    "ink-rgb":  { "$value": "28 28 31", "$description": "Channel form of --brand-ink for ink-at-alpha: rgb(var(--brand-ink-rgb) / 0.65)." },
    "on-lime":  { "$value": "{neutral.850}" },
    "on-ink":   { "$value": "{green.500}" },
    "emphasis-2": { "$value": "#eeff00", "$description": "Gradient stop only." },
    "gradient": { "$value": "linear-gradient(135deg, var(--green-500) 0%, var(--brand-emphasis-2) 100%)" }
  },

  "ext-brand": {
    "anthropic-large": { "$value": "#d97757", "$description": "Anthropic orange, 18px+ bold. EXTERNAL brand: a locked, theme-agnostic constant, never aliased into a semantic token, not part of our palette." },
    "anthropic-body":  { "$value": "#b85033", "$description": "Anthropic orange, darker 12-14px variant for contrast. External brand: locked constant." },
    "linkedin":        { "$value": "#0a66c2", "$description": "LinkedIn brand blue, the LinkedIn mark only. External brand: locked constant." },
    "bupa-blue":        { "$value": "#0079c8", "$description": "Bupa brand blue, Bupa case-study context only. External brand: locked constant." },
    "bupa-blue-dark":   { "$value": "#00609f", "$description": "Bupa brand blue, darker variant. External brand: locked constant." },
    "bupa-blue-subtle": { "$value": "#e6f2fa", "$description": "Bupa brand blue, subtle tint. External brand: locked constant." }
  },

  "fx": {
    "glitch-magenta": { "$value": "#ff2bd6", "$description": "Decorative glitch effect only (footer wordmark). Not a palette colour, never themed." },
    "glitch-cyan":    { "$value": "#00d4ff", "$description": "Decorative glitch effect only. Not a palette colour, never themed." }
  },

  "color": {
    "bg":                { "$value": "{neutral.0}",   "$extensions": { "portfolio": { "themeLight": true } } },
    "bg-elevated":       { "$value": "{neutral.0}",   "$extensions": { "portfolio": { "themeLight": true } } },
    "bg-subtle":         { "$value": "{neutral.100}", "$extensions": { "portfolio": { "themeLight": true } } },
    "text-primary":      { "$value": "{neutral.950}", "$extensions": { "portfolio": { "themeLight": true } } },
    "text-secondary":    { "$value": "{neutral.700}", "$extensions": { "portfolio": { "themeLight": true } } },
    "text-tertiary":     { "$value": "{neutral.600}", "$extensions": { "portfolio": { "themeLight": true } } },
    "border":            { "$value": "{neutral.300}", "$extensions": { "portfolio": { "themeLight": true } } },
    "border-strong":     { "$value": "{neutral.400}", "$extensions": { "portfolio": { "themeLight": true } } },
    "border-hover":      { "$value": "{brand.ink}",   "$extensions": { "portfolio": { "themeLight": true } } },
    "accent":            { "$value": "{neutral.850}", "$extensions": { "portfolio": { "themeLight": true } } },
    "accent-hover":      { "$value": "{neutral.950}", "$extensions": { "portfolio": { "themeLight": true } } },
    "accent-subtle":     { "$value": "{neutral.150}", "$extensions": { "portfolio": { "themeLight": true } } },
    "accent-foreground": { "$value": "{neutral.0}",   "$extensions": { "portfolio": { "themeLight": true } } },
    "focus-ring":        { "$value": "{neutral.850}", "$extensions": { "portfolio": { "themeLight": true } } },
    "link":              { "$value": "{neutral.850}", "$extensions": { "portfolio": { "themeLight": true } } },
    "link-hover":        { "$value": "{neutral.950}", "$extensions": { "portfolio": { "themeLight": true } } },

    "hero-gradient-start": { "$value": "#1a2c5e" },
    "hero-gradient-end":   { "$value": "#0d1846" },
    "hero-text-primary":   { "$value": "{neutral.0}" },
    "panel-navy-start":    { "$value": "#1a3a52" },
    "panel-navy-end":      { "$value": "#0f2436" },
    "on-ink-primary":   { "$value": "rgba(255, 255, 255, 0.88)" },
    "on-ink-secondary": { "$value": "rgba(255, 255, 255, 0.66)" },
    "on-ink-muted":     { "$value": "rgba(255, 255, 255, 0.4)" },
    "on-ink-border":    { "$value": "rgba(255, 255, 255, 0.08)" },
    "neutral-subtle":   { "$value": "{neutral.50}" },
    "static-white":       { "$value": "{neutral.0}", "$description": "Theme-invariant white, never overridden per theme." },
    "static-white-hover": { "$value": "{neutral.200}" },
    "brand-emphasis":   { "$value": "{neutral.850}", "$description": "Theme-aware brand-tinted text, ink on light, lime on dark." },
    "dot-inactive":     { "$value": "rgba(127, 127, 127, 0.45)", "$description": "Inactive carousel dot, theme-neutral mid-grey alpha." },
    "text-muted-em":    { "$value": "rgb(var(--brand-ink-rgb) / 0.55)", "$description": "C-01 muted italic emphasis. 55% ink on light, flips to brand-lime on dark." },
    "on-ink-hover":     { "$value": "rgba(255, 255, 255, 0.18)", "$description": "C-12 hover/focus tint on dark backgrounds." },
    "overlay-soft":   { "$value": "rgba(0, 0, 0, 0.35)" },
    "overlay-base":   { "$value": "rgba(0, 0, 0, 0.62)" },
    "overlay-strong": { "$value": "rgba(0, 0, 0, 0.88)" }
  },

  "font": {
    "display":     { "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
    "body":        { "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif" },
    "mono":        { "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace" },
    "mono-metric": { "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace", "$description": "M-21 tabular mono for metric digits." },
    "serif":       { "$value": "\"PT Serif\", Georgia, serif", "$description": "Secondary, italic display moments only." },
    "feature-mono": { "$value": "\"zero\" 1", "$description": "OpenType slashed-zero feature for mono specimens." }
  },

  "size": {
    "xs":   { "$value": "12px" },
    "sm":   { "$value": "14px" },
    "base": { "$value": "16px" },
    "lg":   { "$value": "18px" },
    "xl":   { "$value": "24px" },
    "2xl":  { "$value": "32px" },
    "3xl":  { "$value": "48px" },
    "2xs":  { "$value": "11px", "$description": "M-61 chip/section-label tier." },
    "meta": { "$value": "13px", "$description": "M-63 meta/caption tier." }
  },

  "text": {
    "h1":      { "$value": "clamp(34px, 5.8vw, 72px)", "$description": "Page H2s; mobile floor 34px." },
    "h2":      { "$value": "clamp(22px, 4vw, 32px)", "$description": "Card titles, ledes, subheads." },
    "body":    { "$value": "16px" },
    "label":   { "$value": "11px", "$description": "Uppercase mono labels." },
    "caption": { "$value": "12px" },
    "nav":     { "$value": "11px", "$description": "Header menu links; equals --text-label today, kept separate so nav can diverge." }
  },

  "display": {
    "hero":       { "$value": "clamp(40px, 9vw, 118px)" },
    "section":    { "$value": "clamp(28px, 5.8vw, 72px)" },
    "card-title": { "$value": "clamp(22px, 4vw, 44px)" },
    "stat-num":   { "$value": "clamp(40px, 7vw, 88px)" },
    "lede":       { "$value": "clamp(20px, 5vw, 24px)" },
    "tight":      { "$value": "-0.04em" },
    "weight":     { "$value": "600", "$description": "Bi-weight bold. Display headings always roman." },
    "stat":       { "$value": "clamp(96px, 12vw, 140px)", "$description": "M-62 editorial stat numerals." }
  },

  "measure": { "$value": "52ch", "$description": "Line-length cap; 52ch Inter renders ~66 real chars." },

  "btn": {
    "sm": { "$value": "32px" },
    "md": { "$value": "40px" },
    "lg": { "$value": "48px" }
  },

  "line": {
    "xs":   { "$value": "1.45" },
    "sm":   { "$value": "1.5" },
    "base": { "$value": "1.5" },
    "lg":   { "$value": "1.45" },
    "xl":   { "$value": "1.25" },
    "2xl":  { "$value": "1.15" },
    "3xl":  { "$value": "1.05" }
  },

  "weight": {
    "regular":   { "$value": "400" },
    "medium":    { "$value": "500" },
    "semibold":  { "$value": "600" },
    "bold":      { "$value": "700" },
    "extrabold": { "$value": "800", "$description": "Five distinct weights; Inter is loaded at 400/500/600/700/800." }
  },

  "tracking": {
    "tight":   { "$value": "-0.02em" },
    "normal":  { "$value": "0" },
    "wide":    { "$value": "0.02em" },
    "mono":    { "$value": "0.01em" },
    "eyebrow": { "$value": "0.18em", "$description": "Wide tracking for uppercase eyebrows." },
    "label":   { "$value": "0.08em", "$description": "Small uppercase labels." }
  },

  "space": {
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "24px" },
    "6":  { "$value": "32px" },
    "7":  { "$value": "48px" },
    "8":  { "$value": "64px" },
    "9":  { "$value": "96px" },
    "10": { "$value": "128px" },
    "11": { "$value": "192px" },
    "12": { "$value": "256px" }
  },

  "section-padding": { "$value": "clamp(var(--space-9), 12vw, var(--space-10))" },

  "duration": {
    "fast":    { "$value": "150ms" },
    "base":    { "$value": "220ms" },
    "slow":    { "$value": "400ms" },
    "counter": { "$value": "1400ms" }
  },

  "ease": {
    "default":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "entrance": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
    "exit":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
  },

  "radius": {
    "none": { "$value": "0", "$description": "Square. No rounding, for sharp-cornered surfaces and full-bleed media." },
    "sm":   { "$value": "8px", "$description": "Small radius. The workhorse for inputs, chips, and small controls." },
    "md":   { "$value": "10px", "$description": "Medium radius. Mid-size controls and insets, a touch rounder than sm." },
    "lg":   { "$value": "14px", "$description": "Large radius. The default for cards and modals." },
    "xl":   { "$value": "20px", "$description": "Extra-large radius. Prominent panels and feature surfaces." },
    "full": { "$value": "999px", "$description": "Full round. Pills, tags, and circular buttons; forces a complete radius at any height." },
    "soft":   { "$value": "{radius.sm}", "$description": "DEPRECATED alias of --radius-sm. Migrate consumers, then remove." },
    "medium": { "$value": "{radius.md}", "$description": "DEPRECATED alias of --radius-md. Migrate consumers, then remove." },
    "card":   { "$value": "{radius.lg}", "$description": "DEPRECATED alias of --radius-lg. Migrate consumers, then remove." },
    "large":  { "$value": "{radius.xl}", "$description": "DEPRECATED alias of --radius-xl. Migrate consumers, then remove." },
    "pill":   { "$value": "{radius.full}", "$description": "DEPRECATED alias of --radius-full. Migrate consumers, then remove." }
  },

  "border": {
    "hairline": { "$value": "1px solid var(--color-border)" },
    "strong":   { "$value": "1px solid var(--color-border-strong)" },
    "focus":    { "$value": "2px solid var(--color-focus-ring)" }
  },

  "focus-ring-offset": { "$value": "2px", "$description": "M-49 outset focus ring." },

  "container": {
    "base": { "$value": "960px" },
    "wide": { "$value": "clamp(1200px, 92vw, 1440px)" }
  },

  "bp": {
    "mobile":    { "$value": "375px" },
    "tablet":    { "$value": "768px" },
    "desktop":   { "$value": "1024px" },
    "wide":      { "$value": "1440px" },
    "ultrawide": { "$value": "1600px" }
  },

  "touch-target-min": { "$value": "44px" },

  "shadow": {
    "none":  { "$value": "none" },
    "soft":  { "$value": "0 1px 2px rgb(var(--brand-ink-rgb) / 0.04), 0 1px 3px rgb(var(--brand-ink-rgb) / 0.06)" },
    "lift":  { "$value": "0 4px 12px rgb(var(--brand-ink-rgb) / 0.06), 0 2px 4px rgb(var(--brand-ink-rgb) / 0.04)" },
    "modal": { "$value": "0 24px 64px rgba(0, 0, 0, 0.5), 0 8px 16px rgba(0, 0, 0, 0.18)", "$description": "C-14 modal/lightbox elevation." }
  },

  "accent-period-shadow": { "$value": "0 1px 2px rgba(0,0,0,0.42), 0 0 0 1px rgba(0,0,0,0.18)", "$description": "M-43 lime period depth on light surfaces." },
  "accent-dot-shadow":    { "$value": "0 1px 3px rgba(0,0,0,0.24)" },

  "glass": {
    "$description": "Liquid-frosted header glass (.m-liquidfrostlit). Light defaults here; dark overrides under darkTheme + osDark. The #lg-dist refraction (feDisplacementMap scale 100) is JS-injected and gated to desktop + hover.",
    "tint":        { "$value": "rgb(250 250 252 / 0.4)", "$description": "Frosted fill tint (padding-box layer)." },
    "edge-top":    { "$value": "rgb(255 255 255 / 0.9)", "$description": "Lit gradient-border top stop, light from above." },
    "edge-bottom": { "$value": "rgb(255 255 255 / 0.06)", "$description": "Lit gradient-border bottom stop." },
    "specular":    { "$value": "inset 0 1px 0 rgb(255 255 255 / 0.7)", "$description": "Inner top highlight, the 3D lit edge." },
    "shadow":      { "$value": "0 10px 30px rgb(0 0 0 / 0.18)", "$description": "Drop shadow under the bar and pill." },
    "blur":        { "$value": "10px", "$description": "Backdrop blur on the Chromium refraction path." },
    "blur-webkit": { "$value": "14px", "$description": "Backdrop blur on the plain-frost fallback (Safari and iOS, no displacement)." },
    "saturate":    { "$value": "170%", "$description": "Backdrop saturation." }
  },

  "darkTheme": {
    "$description": "[data-theme=\"dark\"] semantic overrides (explicit toggle).",
    "color-bg":                { "$value": "{neutral.950}" },
    "color-bg-elevated":       { "$value": "{neutral.900}" },
    "color-bg-subtle":         { "$value": "{neutral.850}" },
    "color-text-primary":      { "$value": "{neutral.150}" },
    "color-text-secondary":    { "$value": "{neutral.500}" },
    "color-text-tertiary":     { "$value": "{neutral.550}" },
    "color-border":            { "$value": "{neutral.800}" },
    "color-border-strong":     { "$value": "{neutral.700}" },
    "color-border-hover":      { "$value": "{brand.lime}" },
    "color-accent":            { "$value": "{green.500}" },
    "color-accent-hover":      { "$value": "{brand.lime-dim}" },
    "color-accent-subtle":     { "$value": "{green.950}" },
    "color-accent-foreground": { "$value": "{neutral.950}" },
    "color-focus-ring":        { "$value": "{green.500}" },
    "color-link":              { "$value": "{green.500}" },
    "color-link-hover":        { "$value": "{neutral.0}" },
    "color-brand-emphasis":    { "$value": "{green.500}" },
    "shadow-soft":             { "$value": "0 1px 2px rgba(0, 0, 0, 0.5), 0 1px 3px rgba(0, 0, 0, 0.3)" },
    "shadow-lift":             { "$value": "0 4px 12px rgba(0, 0, 0, 0.6), 0 2px 4px rgba(0, 0, 0, 0.4)" },
    "accent-period-shadow":    { "$value": "none" },
    "accent-dot-shadow":       { "$value": "none" },
    "color-text-muted-em":     { "$value": "{brand.lime}" },
    "glass-tint":        { "$value": "rgb(var(--brand-ink-rgb) / 0.5)" },
    "glass-edge-top":    { "$value": "rgb(255 255 255 / 0.4)" },
    "glass-edge-bottom": { "$value": "rgb(255 255 255 / 0.03)" },
    "glass-specular":    { "$value": "inset 0 1px 0 rgb(255 255 255 / 0.25)" },
    "glass-shadow":      { "$value": "0 10px 30px rgb(0 0 0 / 0.4)" }
  },

  "osDark": {
    "$description": "@media (prefers-color-scheme: dark) :root:not([data-theme=light]) fallback. FAITHFUL transcription incl. current hex-vs-var and link-hover quirks; see findings.",
    "color-bg":                { "$value": "#0a0a0b" },
    "color-bg-elevated":       { "$value": "#141416" },
    "color-bg-subtle":         { "$value": "#1c1c1f" },
    "color-text-primary":      { "$value": "#f4f4f5" },
    "color-text-secondary":    { "$value": "#a1a1aa" },
    "color-text-tertiary":     { "$value": "#909096" },
    "color-border":            { "$value": "#27272a" },
    "color-border-strong":     { "$value": "#3f3f46" },
    "color-accent":            { "$value": "{green.500}" },
    "color-accent-hover":      { "$value": "{brand.lime-dim}" },
    "color-accent-subtle":     { "$value": "{green.950}" },
    "color-accent-foreground": { "$value": "#0a0a0b" },
    "color-focus-ring":        { "$value": "{green.500}" },
    "color-link":              { "$value": "{green.500}" },
    "color-link-hover":        { "$value": "{brand.lime-dim}" },
    "color-brand-emphasis":    { "$value": "#d2ff37" },
    "color-text-muted-em":     { "$value": "#d2ff37" },
    "glass-tint":        { "$value": "rgb(var(--brand-ink-rgb) / 0.5)" },
    "glass-edge-top":    { "$value": "rgb(255 255 255 / 0.4)" },
    "glass-edge-bottom": { "$value": "rgb(255 255 255 / 0.03)" },
    "glass-specular":    { "$value": "inset 0 1px 0 rgb(255 255 255 / 0.25)" },
    "glass-shadow":      { "$value": "0 10px 30px rgb(0 0 0 / 0.4)" }
  }
}
